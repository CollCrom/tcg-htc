{
  "name": "tcg-htc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test:upstream": "pnpm --filter @fyendal/engine --filter @fyendal/cards --filter @fyendal/bot test",
    "smoke": "pnpm --filter @tcg-htc/runner smoke",
    "suite": "pnpm --filter @tcg-htc/runner suite",
    "typecheck": "pnpm --filter \"./packages/**\" typecheck",
    "test": "pnpm --filter \"./packages/**\" test",
    "check:glossary": "pnpm --filter @tcg-htc/runner check:glossary",
    "lint:workflows": "bash scripts/lint-workflows.sh"
  }
}
